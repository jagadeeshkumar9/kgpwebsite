# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=3000
# Comma-separated list of origins allowed to call the API if the frontend
# is hosted separately from this backend (leave blank if served together).
ALLOWED_ORIGINS=

# ---- SMTP (used by Nodemailer to send contact-form emails) ----
# Example using Gmail: create a Google Account "App Password" (not your normal
# password) at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kgpinovation@gmail.com
SMTP_PASS=your-app-password-here

# Address the contact form emails are sent FROM (often same as SMTP_USER)
MAIL_FROM="KGP Innovation Website" <kgpinovation@gmail.com>

# Address(es) the contact form emails are sent TO — comma-separated for multiple
MAIL_TO=admin@kgpinovation.in,kgpinovation@gmail.com
